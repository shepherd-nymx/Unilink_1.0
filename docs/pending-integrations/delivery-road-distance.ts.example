import {createClient} from 'npm:@supabase/supabase-js@2.58.0';
const headers={'Content-Type':'application/json','Access-Control-Allow-Origin':'*','Access-Control-Allow-Headers':'content-type,apikey,authorization','Access-Control-Allow-Methods':'POST,OPTIONS'};
const json=(body:unknown,status=200)=>new Response(JSON.stringify(body),{status,headers});
Deno.serve(async(req:Request)=>{
 if(req.method==='OPTIONS')return new Response(null,{headers});
 if(req.method!=='POST')return json({error:'Method not allowed'},405);
 try{
  const body=await req.json();
  const client=createClient(Deno.env.get('SUPABASE_URL')!,Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!,{auth:{persistSession:false}});
  const {data:admin,error:authError}=await client.rpc('verify_admin_login',{p_username:body.username,p_password:body.password});
  if(authError||!admin?.length)return json({error:'Admin credentials required'},401);
  const key=Deno.env.get('GOOGLE_ROUTES_API_KEY');
  if(!key)return json({error:'Road routing is not configured. Verify a road route manually and record its source; no straight-line estimate is used.'},503);
  const {data:q,error}=await client.from('delivery_quotes').select('shop_id,latitude,longitude').eq('id',body.quote_id).single();if(error)throw error;
  const [{data:shop},{data:capacity}]=await Promise.all([client.from('shops').select('latitude,longitude').eq('id',q.shop_id).single(),client.from('driver_delivery_capacity').select('transport').eq('driver_id',body.driver_id).single()]);
  if(!capacity||shop?.latitude==null||shop?.longitude==null)return json({error:'Verified transport and shop pickup GPS are required.'},400);
  if(['truck','van'].includes(capacity.transport))return json({error:'Verify a vehicle-appropriate road route manually for bulky transport.'},400);
  const mode=capacity.transport==='walking'?'WALK':capacity.transport==='bicycle'?'BICYCLE':'DRIVE';
  const response=await fetch('https://routes.googleapis.com/directions/v2:computeRoutes',{method:'POST',headers:{'Content-Type':'application/json','X-Goog-Api-Key':key,'X-Goog-FieldMask':'routes.distanceMeters'},body:JSON.stringify({origin:{location:{latLng:{latitude:Number(shop.latitude),longitude:Number(shop.longitude)}}},destination:{location:{latLng:{latitude:Number(q.latitude),longitude:Number(q.longitude)}}},travelMode:mode}),signal:AbortSignal.timeout(12000)});
  const result=await response.json();const metres=result.routes?.[0]?.distanceMeters;
  if(!response.ok||!Number.isFinite(metres)||metres<0)return json({error:'No verified road route returned. Do not substitute straight-line distance.'},502);
  return json({road_km:Math.round(metres/10)/100,route_evidence:`Google Routes ${mode}, checked ${new Date().toISOString()}`,note:'Review route suitability before proposing the fee.'});
 }catch{return json({error:'Could not calculate the road route.'},500)}
});
